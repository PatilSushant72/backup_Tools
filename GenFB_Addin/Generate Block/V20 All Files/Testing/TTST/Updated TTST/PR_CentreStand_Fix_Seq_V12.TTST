TEST_CASE "MemoryReset"

PROPERTY
AUTHOR : ""
VERSION : "0.1"
COMMENT : ""
SCOPE : "PLC"
PLCSIM_INSTANCE_NAME : "myplc"
TEST_EXECUTION_MODE : "ExternallyManagedPlcSimAdvInstance"
END_PROPERTY

INIT


PLC_MEMORY_RESET :=True;
END_INIT



VAR
